# Development Environment Variables
# Copy this file to .env for local development

# Frontend API Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:5000

# AI API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# N8N Configuration (Required)
N8N_API_KEY=your_n8n_api_key_here
N8N_BASE_URL=https://n8n.casamccartney.link

# Optional: Affine Integration
AFFINE_API_KEY=your_affine_api_key_here
AFFINE_WORKSPACE_ID=your_affine_workspace_id_here

# Optional: Pinecone (Vector Database)
PINECONE_API_KEY=your_pinecone_api_key_here

# Application Settings
DEBUG=True
ENVIRONMENT=development
